{
  "name": "nextjs-findtern",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern drizzle-kit generate",
    "db:push": "npm run db:generate && DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern node --experimental-strip-types scripts/db-push.ts",
    "db:seed": "npm run db:push && DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern SESSION_SECRET=verify-only-secret-at-least-32-characters node --experimental-strip-types scripts/seed.ts",
    "db:reset": "npm run db:seed",
    "db:verify": "DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern SESSION_SECRET=verify-only-secret-at-least-32-characters node --experimental-strip-types scripts/db-verify.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:pull-live": "bash scripts/pull-live.sh",
    "db:make-admin": "node --experimental-strip-types scripts/make-admin.ts",
    "db:studio": "DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern drizzle-kit studio",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types \"src/lib/*.test.ts\" \"src/lib/**/*.test.ts\" \"src/components/**/*.test.ts\"",
    "test:security": "node --test --experimental-strip-types \"src/lib/security/*.test.ts\"",
    "e2e": "node e2e/run.mjs",
    "shots": "PORT=3100 DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern SESSION_SECRET=verify-only-secret-at-least-32-characters node --experimental-strip-types scripts/shots.ts",
    "db:import-colleges": "DATABASE_URL=${DATABASE_URL:-postgresql://findtern:findtern_dev@localhost:5432/findtern} node --experimental-strip-types scripts/import-colleges.ts",
    "db:seed-colleges": "DATABASE_URL=${DATABASE_URL:-postgresql://findtern:findtern_dev@localhost:5432/findtern} node --experimental-strip-types scripts/seed-colleges.ts",
    "test:e2e:college": "node --test e2e/college-partners.e2e.mjs",
    "test:e2e:college-money": "node --test e2e/college-money.e2e.mjs",
    "test:e2e:drive": "node --test --test-concurrency=1 e2e/drive-journey.e2e.mjs",
    "e2e:admin": "node --test e2e/admin.e2e.mjs",
    "test:e2e:messaging": "node --test --test-concurrency=1 e2e/messaging.e2e.mjs",
    "test:e2e:notify": "node --test --test-concurrency=1 e2e/notify-prefs.e2e.mjs",
    "test:e2e:upload": "node --test --test-concurrency=1 e2e/upload-progress.e2e.mjs",
    "test:e2e:presence": "node --test --test-concurrency=1 e2e/presence.e2e.mjs",
    "test:e2e:takedown": "node --test --test-concurrency=1 e2e/listing-takedown.e2e.mjs",
    "test:e2e:projects": "node --test --test-concurrency=1 e2e/projects-lifecycle.e2e.mjs",
    "test:e2e:limits": "node --test --test-concurrency=1 e2e/profile-limits.e2e.mjs",
    "qa": "node e2e/qa.mjs",
    "qa:serve": "node e2e/qa-serve.mjs",
    "qa:seed": "node e2e/seed-situations.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@node-rs/argon2": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "motion": "^14.0.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.8.69",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
