{
  "name": "nextjs-findtern",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern drizzle-kit generate",
    "db:push": "npm run db:generate && DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern node --experimental-strip-types scripts/db-push.ts",
    "db:seed": "npm run db:push && DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern SESSION_SECRET=verify-only-secret-at-least-32-characters node --experimental-strip-types scripts/seed.ts",
    "db:reset": "npm run db:seed",
    "db:verify": "DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern SESSION_SECRET=verify-only-secret-at-least-32-characters node --experimental-strip-types scripts/db-verify.ts",
    "db:studio": "DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern drizzle-kit studio",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types src/lib/**/*.test.ts",
    "test:security": "node --test --experimental-strip-types src/lib/security/",
    "shots": "PORT=3100 DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern SESSION_SECRET=verify-only-secret-at-least-32-characters node --experimental-strip-types scripts/shots.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@gsap/react": "^2.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "framer-motion": "^14.0.0",
    "googleapis": "^183.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
