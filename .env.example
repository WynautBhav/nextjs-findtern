# ── Database ────────────────────────────────────────────────────────────────
# Local testing against a copy of live: npm run db:pull-live, then db:migrate.
DATABASE_URL=postgresql://findtern:findtern_dev@localhost:5432/findtern_live
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Used by scripts/pull-live.sh only
LIVE_SSH=user@kvm-host
LIVE_DB=findtern
LIVE_PG_USER=postgres
LIVE_UPLOADS=/path/to/FindTern/uploads

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Absolute origin for links in emails and signed URLs
PUBLIC_ORIGIN=https://findtern.in

# Auth & signing (min 32 characters each)
SESSION_SECRET=
SIGNING_SECRET=

# ── Safety switches (defaults are safe for local testing) ───────────────────
# log = write emails to logs/mail/ instead of sending (default outside production)
MAIL_MODE=log
# on = run interview reminders and notification jobs in-process
SCHEDULERS=off
# on = upgrade legacy plaintext passwords to argon2 on login.
# Keep off while the legacy site still reads the same database.
PASSWORD_UPGRADE=off

# ── Files ───────────────────────────────────────────────────────────────────
# New uploads (default: .private-uploads in the project root)
UPLOAD_ROOT=
# The legacy app's uploads/ folder, read-only (default: .legacy-uploads)
LEGACY_UPLOAD_ROOT=

# ── Google sign-in and Meet links ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://findtern.in/auth/google/callback
# Findtern's calendar (Meet links); legacy registered URI
FINDTERN_GOOGLE_OAUTH_REDIRECT_URI=https://findtern.in/google/callback
MEET_CALENDAR_ID=primary

# ── Razorpay (use test keys locally) ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test mode: "free" completes checkout and activation without Razorpay (staging only).
# PAYMENTS_MODE=free

# ── AI interview results (Incruiter). Webhook is disabled until set; give
# Incruiter the same value as the x-webhook-secret header.
INCRUITER_WEBHOOK_SECRET=

# ── Invoices (GST) ──────────────────────────────────────────────────────────
FINDTERN_LEGAL_NAME=
FINDTERN_GSTIN=
FINDTERN_BILLING_ADDRESS=
FINDTERN_BILLING_EMAIL=

# ── Email (SMTP; Resend works via smtp.resend.com) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Findtern <connect@findtern.in>

# ── Analytics (defaults in code are the live IDs) ───────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Findtern chatbot ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Rate limits key on the client IP. Behind our nginx (deploy/nginx-findtern.conf),
# set TRUST_PROXY=1 so the IP nginx forwards is used. Leave unset only when the
# app is not behind a proxy you control - forwarding headers are then ignored.
TRUST_PROXY=1
