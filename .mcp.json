{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "-e",
        "/usr/bin/chromium",
        "--isolated",
        "--viewport=1440x900",
        "--screenshotFormat=jpeg",
        "--screenshotMaxWidth=1440",
        "--chromeArg=no-sandbox"
      ]
    },
    "awwwards": {
      "command": "npx",
      "args": [
        "-y",
        "awwwards-mcp@1.18.0"
      ]
    }
  }
}
