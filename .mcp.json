{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "-e",
        "/usr/bin/chromium",
        "--isolated",
        "--viewport=1440x900",
        "--screenshotFormat=jpeg",
        "--screenshotMaxWidth=1440",
        "--chromeArg=no-sandbox"
      ]
    }
  }
}
