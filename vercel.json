{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "buildCommand": "node --experimental-strip-types scripts/migrate.ts && next build",
  "crons": [
    { "path": "/api/cron/tick", "schedule": "10 3 * * *" },
    { "path": "/api/cron/payment-reminders", "schedule": "30 3 * * *" },
    { "path": "/api/cron/refund-reconcile", "schedule": "30 4 * * *" },
    { "path": "/api/cron/roster-import-purge", "schedule": "15 4 * * *" },
    { "path": "/api/cron/proposal-expiry", "schedule": "45 18 * * *" }
  ]
}
